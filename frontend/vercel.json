{
  "framework": "nextjs",
  "buildCommand": "NEXT_OUTPUT=export npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api-proxy/:path*",
      "destination": "https://saki-gateway.indevs.in/:path*"
    },
    {
      "source": "/:username/v1/:path*",
      "destination": "https://saki-gateway.indevs.in/:username/v1/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://saki-gateway.indevs.in/v1/:path*"
    },
    {
      "source": "/v2/:path*",
      "destination": "https://saki-gateway.indevs.in/v2/:path*"
    },
    {
      "source": "/v3/:path*",
      "destination": "https://saki-gateway.indevs.in/v3/:path*"
    },
    {
      "source": "/health",
      "destination": "https://saki-gateway.indevs.in/health"
    },
    {
      "source": "/health/d1",
      "destination": "https://saki-gateway.indevs.in/health/d1"
    },
    {
      "source": "/openapi.json",
      "destination": "https://saki-gateway.indevs.in/openapi.json"
    }
  ]
}
