# AI Gateway Environment Variables
# Copy to .env and fill in values

# App
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_gateway

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","https://your-dashboard.com"]

# Rate Limits
DEFAULT_RATE_LIMIT=100
DEFAULT_BURST=20
